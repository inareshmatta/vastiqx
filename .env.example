# VastiqX environment
# Copy to .env.local and fill in real values.

# Enables live Gemma 4 tool-calling through the OpenRouter OpenAI-compatible API.
OPENROUTER_API_KEY=

# Default: google/gemma-4-31b-it. Alternatives: google/gemma-4-26b-a4b-it,
# google/gemma-4-31b-it:free, google/gemma-4-26b-a4b-it:free
OPENROUTER_MODEL=google/gemma-4-31b-it

# Optional OpenRouter attribution headers.
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=VastiqX

# Public canonical URL used by metadata, sitemap, robots and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: move the file-backed demo store outside the repository.
# VASTIQX_DATA_DIR=.data
